<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnCargar"
        android:text="@string/btn_cargar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:textSize="14sp"
        tools:text="Aquí se mostrarán los socios..." />

    <EditText
        android:id="@+id/etDni"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Ingresa el DNI del socio"
        android:inputType="number" />

    <Button
        android:id="@+id/btnBuscarPorDni"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscar por DNI" />

    <TextView
        android:id="@+id/txtResultadoIndividual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="16sp"
        tools:text="Estado del socio..." />
</LinearLayout>
